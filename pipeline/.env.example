# Copy to pipeline/.env. Existing shell variables take precedence.
# Paper account credentials only. Missing credentials safely disable trading.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

ALPACA_STOCK_SYMBOLS=SPY,AAPL,MSFT
# iex (default) or sip (requires the corresponding entitlement).
ALPACA_STOCK_FEED=iex

# Stock underlyings: the service discovers and verifies actual call/put contracts.
# Leave blank to disable new option entries. Existing positions remain monitored.
ALPACA_OPTION_UNDERLYINGS=SPY,AAPL,MSFT,QQQ,NVDA
# Indicative supports paper automation: derived quotes and 15-minute-delayed trades.
# OPRA supplies consolidated quotes and requires the corresponding entitlement.
ALPACA_OPTION_FEED=indicative

# Optional hard option-policy overrides; shown values are the defaults.
# OPTION_MIN_DTE=7
# OPTION_MAX_DTE=45
# OPTION_MIN_OPEN_INTEREST=100
# OPTION_MAX_OPEN_INTEREST_AGE_DAYS=7
# OPTION_MIN_QUOTE_SIZE=1
# OPTION_MAX_SPREAD_PCT=0.10
# OPTION_MAX_SPREAD_ABSOLUTE=0.50
# OPTION_MAX_QUOTE_AGE_SECONDS=30
# OPTION_MAX_CANDIDATES=12
# OPTION_MAX_TRADE_PCT=0.01
# OPTION_MAX_UNDERLYING_PCT=0.05
# OPTION_MAX_TOTAL_PCT=0.10
# OPTION_MAX_CONTRACTS=5
# OPTION_STOP_LOSS_PCT=20
# OPTION_TAKE_PROFIT_PCT=40
# OPTION_EXIT_DTE=1
# OPTION_ENTRY_TIMEOUT_SECONDS=120
# OPTION_EXIT_REPRICE_SECONDS=30
# OPTION_MAX_PRICE_DRIFT_PCT=0.02

# Optional; required only for Jev automation, which starts disabled.
TYPESAFE_API_KEY=
# Legacy alternative: TYPESAFE_AI_API_KEY

# Keep loopback binding unless an authenticated proxy protects this service.
HOST=127.0.0.1
PORT=8765
FEED_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
