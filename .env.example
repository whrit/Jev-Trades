# Copy to .env.local in the repository root; restart Next.js after changes.
# Public browser URLs only. Never put Alpaca or TypeSafe secrets here.
NEXT_PUBLIC_MARKET_FEED_URL=http://127.0.0.1:8765

# Optional override; otherwise uses NEXT_PUBLIC_MARKET_FEED_URL + /stream.
# NEXT_PUBLIC_MARKET_STREAM_URL=http://127.0.0.1:8765/stream
